# Copy what you need into .streamlit/secrets.toml (on your computer) or into the app's Secrets box on
# Streamlit Community Cloud. Never share or commit the real file.

# Angel One SmartAPI (free) — live ticks, live option chain, 2 years of intraday history. Optional.
[angelone]
api_key = "your-smartapi-key"
client_id = "A123456"
mpin = "1234"
totp_secret = "YOUR-TOTP-TEXT-KEY"

# Cloud hosting: save your settings and trades in a private GitHub Gist (the cloud disk is wiped on restarts).
# Create a token at github.com/settings/tokens (classic, scope: gist) and a secret gist with any file in it.
[storage]
github_token = "ghp_xxxxxxxxxxxxxxxxxxxx"
gist_id = "0123456789abcdef0123456789abcdef"

# Optional starting profile, so a fresh cloud copy doesn't ask the welcome questions again.
[profile]
name = "Your name"
capital = 100000
risk_pct = 1.0
style = "Swing"
watchlist = ["NIFTY 50", "BANK NIFTY", "SENSEX", "RELIANCE", "HDFCBANK", "ICICIBANK"]
onboarded = true
